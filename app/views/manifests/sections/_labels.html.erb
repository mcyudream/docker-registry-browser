<% if manifest.labels.any? %>
  <section class="manifest-section">
    <div class="subsection-title"><h3>镜像标签</h3><span><%= manifest.labels.size %> 项</span></div>
    <div class="data-table" role="table" aria-label="镜像标签">
      <div class="data-row data-head" role="row"><span>键</span><span>值</span></div>
      <% manifest.labels.each do |key, value| %>
        <div class="data-row" role="row"><code><%= key %></code><code><%= value %></code></div>
      <% end %>
    </div>
  </section>
<% end %>
