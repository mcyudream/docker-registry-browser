<section class="manifest-section">
  <h3>镜像概览</h3>
  <div class="metric-grid">
    <div><span>平台架构</span><strong><%= manifest.display_name %></strong></div>
    <div><span>镜像大小</span><strong><%= number_to_human_size(manifest.size) %></strong></div>
    <div><span>创建时间</span><strong><%= l manifest.created %></strong></div>
  </div>
  <div class="metadata-row">
    <span>内容摘要</span><code><%= manifest.content_digest %></code>
    <button type="button" class="copy-icon-button" data-copy-text="<%= manifest.content_digest %>" title="复制内容摘要">复制</button>
  </div>
</section>
