<section class="manifest-section">
  <div class="subsection-title"><h3>构建历史</h3><span><%= manifest.history.size %> 条记录</span></div>
  <div class="history-list">
    <% manifest.history.each do |entry| %>
      <div class="history-row">
        <span class="history-dot" aria-hidden="true"></span>
        <div><time><%= l entry.created %></time><% if entry.comment.present? %><small><%= entry.comment %></small><% end %><code><%= entry.created_by %></code></div>
      </div>
    <% end %>
  </div>
</section>
