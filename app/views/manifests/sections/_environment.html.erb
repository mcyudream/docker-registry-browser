<% if manifest.env.any? %>
  <section class="manifest-section">
    <div class="subsection-title"><h3>环境变量</h3><span><%= manifest.env.size %> 项</span></div>
    <div class="data-table" role="table" aria-label="环境变量">
      <div class="data-row data-head" role="row"><span>变量名</span><span>值</span></div>
      <% manifest.env.sort.each do |env| %>
        <%- key, value = env.split("=", 2) %>
        <div class="data-row" role="row"><code><%= key %></code><code><%= value %></code></div>
      <% end %>
    </div>
  </section>
<% end %>
