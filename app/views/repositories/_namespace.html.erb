<section class="namespace-group" data-namespace-group>
  <header class="namespace-header" id="namespace-<%= namespace %>">
    <div>
      <span class="namespace-label">命名空间</span>
      <h2><%= namespace.presence || "根目录" %></h2>
    </div>
    <span class="namespace-count"><%= repositories.size %> 个镜像</span>
  </header>
  <ul class="repository-list">
          <%= content_tag :div, class: {collapse: configs.collapse_namespaces}, id: "namespace-#{namespace}-repos" do %>
            <% repositories.each do |repository| %>
              <%= render "repository", repository: repository %>
            <% end %>
          <% end %>

          <%= content_tag :button, class: "collapsed namespace-toggle", data: {"bs-toggle": "collapse", "bs-target": "#namespace-#{namespace}-repos"} do %>
            <span class="if-collapsed">展开镜像仓库</span>
            <span class="if-not-collapsed">收起</span>
          <% end if configs.collapse_namespaces %>
  </ul>
</section>
