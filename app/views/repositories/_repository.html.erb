<li class="repository-item" data-repository-name="<%= repository.name.downcase %>">
  <%= link_to repository_path(repository.name), class: "repository-link" do %>
    <span class="repository-icon" aria-hidden="true">IMG</span>
    <div class="repository-name">
      <strong><%= repository.image %></strong>
      <small><%= repository.name %></small>
    </div>
    <span class="chevron" aria-hidden="true">›</span>
  <% end %>
</li>
