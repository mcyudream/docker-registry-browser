<div class="sort-bar">
  <span>排序方式</span>
  <div class="segmented-control" aria-label="排序方式">
    <% {"api" => "仓库顺序", "name" => "名称", "version" => "版本"}.each do |key, name| %>
      <%= link_to name, {sort_tags_by: key, sort_tags_order: sort_tags_order}, class: class_names(active: sort_tags_by == key) %>
    <% end %>
  </div>
  <div class="segmented-control" aria-label="排序方向">
    <% {"asc" => "升序", "desc" => "降序"}.each do |key, name| %>
      <%= link_to name, {sort_tags_order: key, sort_tags_by: sort_tags_by}, class: class_names(active: sort_tags_order == key) %>
    <% end %>
  </div>
</div>
