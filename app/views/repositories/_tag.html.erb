<li class="version-item" data-tag-name="<%= tag.downcase %>">
  <%= link_to tag_path(repo: repository.name, tag: tag), class: "version-link" do %>
    <span class="tag-icon">TAG</span>
    <span class="version-name"><strong><%= tag %></strong><small><%= repository.name %>:<%= tag %></small></span>
    <% if tag == "latest" %><span class="latest-badge">默认</span><% end %>
    <span class="version-open">查看详情 <span aria-hidden="true">›</span></span>
  <% end %>
</li>
