<nav class="breadcrumb-row" aria-label="面包屑">
  <%= link_to "镜像目录", root_path %><span>/</span>
  <%= link_to @repository.name, repository_path(@repository.name) %><span>/</span>
  <strong><%= @tag.name %></strong>
</nav>

<section class="image-hero">
  <div class="repository-hero-icon">IMG</div>
  <div class="repository-hero-copy">
    <p class="eyebrow">镜像详情</p>
    <h1><%= @repository.name %>:<%= @tag.name %></h1>
    <p class="digest-line" title="<%= @tag.content_digest %>"><span>内容摘要</span> <code><%= @tag.content_digest %></code></p>
  </div>
</section>

<% if Rails.configuration.x.public_registry_url %>
  <% command = pull_command(@repository.name, @tag.name) %>
  <section class="pull-command-card">
    <div><span class="command-label">Docker 拉取命令</span><code><%= command %></code></div>
    <button type="button" class="copy-button" data-copy-text="<%= command %>">复制</button>
  </section>
<% end %>

<section class="manifest-panel">
  <header class="section-heading">
    <div><p class="eyebrow">镜像清单</p><h2>平台与构建信息</h2></div>
    <span><%= @tag.manifests.size %> 个平台</span>
  </header>

  <ul class="nav manifest-tabs" role="tablist">
    <% @tag.manifests.each do |manifest| %>
      <li class="nav-item">
        <%= link_to manifest.display_name, "##{dom_id(manifest)}", data: {"bs-toggle": "tab"}, class: {"nav-link": true, "active": @tag.manifests.first == manifest} %>
      </li>
    <% end %>
  </ul>

  <div class="tab-content">
    <% @tag.manifests.each do |manifest| %>
      <%= content_tag :div, id: dom_id(manifest), class: {"tab-pane": true, "active": @tag.manifests.first == manifest} do %>
        <%= render manifest %>
      <% end %>
    <% end %>
  </div>
</section>

<%= render "delete" if Rails.application.config.x.delete_enabled %>
